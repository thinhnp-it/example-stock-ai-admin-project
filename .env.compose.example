# Copy to .env for local Compose use. Keep this file free of credentials.
IMAGE_PREFIX=ai-admin
APP_IMAGE_TAG=local

# Local default serves HTTP on port 80. For production set your DNS hostname,
# for example: CADDY_SITE=ai.example.com (Caddy will manage HTTPS certificates).
CADDY_SITE=:80

# Optional public API base URL overrides. Leave empty to use same-origin Caddy routes.
PUBLIC_AUTH_API_BASE_URL=
PUBLIC_DATA_API_BASE_URL=
PUBLIC_RAG_API_BASE_URL=
PUBLIC_DAG_API_BASE_URL=
PUBLIC_TAG_API_BASE_URL=
PUBLIC_AI_API_BASE_URL=
PUBLIC_API_BASE_URL=
